# Nexus V2 local configuration (copy to .env; never commit secrets).
#
# Single-URL form (takes precedence when set):
# NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@127.0.0.1:5432/nexus
#
# Or individual parts (match docker-compose.yml defaults):
NEXUS_DB_HOST=127.0.0.1
NEXUS_DB_PORT=5432
NEXUS_DB_USER=nexus
NEXUS_DB_PASSWORD=nexus
NEXUS_DB_NAME=nexus

# Persistence test database (created automatically if missing):
# NEXUS_TEST_DATABASE_URL=postgresql+asyncpg://nexus:nexus@127.0.0.1:5432/nexus_test

# Alembic uses NEXUS_DATABASE_URL (or ALEMBIC_DATABASE_URL) when set,
# else falls back to the URL in alembic.ini.
# ALEMBIC_DATABASE_URL=postgresql+asyncpg://nexus:nexus@127.0.0.1:5432/nexus

# Component 7 local agent runtime (provider-agnostic; no secrets here).
# The provider library reads its own API key from its own variables.
# NEXUS_LLM_MODEL=openai:gpt-4o
# NEXUS_LLM_TEMPERATURE=0.2
# NEXUS_LLM_MAX_TOKENS=1024
# NEXUS_LLM_TIMEOUT_S=60
# NEXUS_LLM_MAX_INPUT_CHARS=65536
# NEXUS_LLM_MAX_HISTORY=20
# Optional live-model smoke test (off unless explicitly enabled):
# NEXUS_RUN_LLM_SMOKE=1

# Component 8 MCP servers (local operator configuration file).
# NEXUS_MCP_CONFIG_PATH=config/mcp_servers.json
